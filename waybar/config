{
    "layer": "top", // Waybar at top layer
    "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": [],
    "modules-right": ["custom/notification", "tray", "hyprland/language", "pulseaudio","memory","network","battery","clock"],
   
    // Modules configuration
    
    "hyprland/window": {
       // "format": "",
    //    "max-length": 60 ,
    },



     "hyprland/workspaces": {
         "disable-scroll": false,
         "all-outputs": true,
         "format": "{name}:{icon}",
         "format-icons": {
             "1": "Null",
             "2": "S",
             "3": "TG",
             "4": "Asprt",
             "5": "J-F",
             "6": "",
             "7": "Cod",
             "8": "",
             "9": "M",
             "10": "Pct",
             "11": "Osu",
             "12": "Frx",
             "13": "Trt",
             "14": "Kta",
             "15": "Ed",
             "16": "Drd"
    //         "urgent": "",
    //         "focused": "",
    //        "default": ""
         }
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": "U"
        }
    },
    "hyprland/language": {
    "format": "{}",
    "min-length": 3,
    "format-en":"us",
    "format-uk":"uk"
 //  "keyboard-name": "at-translated-set-2-keyboard"
   },    
    "hyprland/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "hyprland/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },


    "tray": {
        "icon-size": 27,
        "spacing": 2,
        "default": true 

    },
    "clock": {
        "format": "{:%F %I:%M:%S %p}",
        "interval": 1,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
       "return-type": "json",
       "exec-if": "which swaync-client",
       "exec": "swaync-client -swb",
       "on-click": "swaync-client -t -sw",
       "on-click-right": "swaync-client --close-all",
       "escape": true
    },
    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 1,
        "tooltip": true
    },
    "memory": {
        "format": " {}%",
        "interval": 1
    },

    
    "disk#ssd": {
        "interval": 10,
        "format": "{path} {percentage_used}%",
        "path": "/",
        "tooltip": true,
        "warning": 80,
        "critical": 90
    },

        "disk": {
        "interval": 10,
        "format": "{path} {percentage_used}%",
        "path": "/home",
        "tooltip": true,
        "warning": 80,
        "critical": 90
    },



"battery": {
        "format": "{icon}",
        "format-alt": "{time}  {icon}",
        "tooltip-format": "{time}",
        "format-alt-click": "click-right",
        "format-icons": ["󰁺", "󰁼", "󰁿", "󰁹"],
        "format-charging": "󰚥",
        "interval": 1,
        "on-click": "",
        "states": {
            "warning": 50,
            "critical": 20
        }
    },

    "custom/notification": {
       "tooltip": false,
       "format": "{icon}",
       "format-icons": {
         "notification": "<span foreground='red'><sup></sup></span>",
         "none": " ",
         "dnd-notification": "<span foreground='red'><sup></sup></span>",
         "dnd-none": " "
       },
       "return-type": "json",
       "exec-if": "which swaync-client",
       "exec": "swaync-client -swb",
       "on-click": "swaync-client -t -sw",
       "on-click-right": "swaync-client --close-all",
       "escape": true
     },
    "network": {
    // "interface": "enp1s0", // (Optional) To force the use of this interface
        "format-wifi":"󰖩 {signalStrength}%",
        "format-ethernet": " {ifname}",
    // "format-ethernet": "DIGI 1000 ",
    // "format-linked": "DIGI (No IP) ",
        "format-disconnected": "Disconnected ⚠"
    // "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "scroll-step": 5, // %, can be a float
        "format": "{icon} {volume}%",
        "format-alt-click": "click-right",
        "format-bluetooth": "󰂰",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        }
    },

        "escape": true

    }
